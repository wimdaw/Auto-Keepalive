{
  "name": "auto-keepalive",
  "buildCommand": "npm run build",
  "installCommand": "npm install --include=dev",
  "outputDirectory": "./dist",
  "cloudFunctions": {
    "maxDuration": 120,
    "regions": {
      "overseas": ["ap-hongkong"]
    }
  },
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "schedules": [
    {
      "name": "keepalive-cron-every-1m",
      "cron": "* * * * *",
      "path": "/api/cron/tick",
      "method": "GET",
      "timezone": "Asia/Shanghai"
    }
  ]
}
